
<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="X-UA-Compatible" content="IE=EDGE" />
  <meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=1,user-scalable=no">
  <meta http-equiv="Expires" content="-1">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Cache-control" content="no-cache">
  <meta http-equiv="Cache" content="no-cache">
  <meta charset="UTF-8">
  <script>
    function getQueryString(name, url) {
      var search = url ? url.substr(url.indexOf('?')) : window.location.search;
      var reg = new RegExp('(^|&)' + name + '=([^&]*)(&|$)', 'i');
      var r = search.substr(1).match(reg);
      if (r != null) {
          return unescape(r[2]);
      }
      return null;
    };

    function format(processObj) {
      if (typeof processObj.wmRotate !== 'undefined') {
        var wmRotate = parseFloat(processObj.wmRotate);
        if (!isNaN(wmRotate)) {
          processObj.wmRotate = wmRotate / 180 * Math.PI;
        }
      } else {
        processObj.wmRotate = -Math.PI / 4;
      }

      if (typeof processObj.wmType !== 'undefined') {
        var wmType = parseFloat(processObj.wmType);
        if (!isNaN(wmType)) {
          processObj.wmType = wmType;
        }
      }

      if (typeof processObj.wmFont !== 'undefined') {
        var wmFont = processObj.wmFont.split('_').join(' ');
        processObj.wmFont = wmFont;
      }

      if (typeof processObj.wmColor !== 'undefined') {
        var wmColor = processObj.wmColor.split('_').join(',');
        processObj.wmColor = wmColor;
      }

      return processObj;
    }

    !function() {
      var processParams = getQueryString('x-oss-process');
      var processObj = {};
      if (processParams) {
        var processArr = processParams.split(',');
        processArr.shift();
        for (var i = 0; i < processArr.length; i++) {
          var item = processArr[i];
          var arr = /([^_]+)_(.+)/.exec(item);
          if (arr !== null && typeof arr[1] !== 'undefined') {
            processObj[arr[1]] = arr[2];
          }
        };
      }

      processObj = format(processObj);

      window._page_start_time = (new Date).getTime();
      window._static_host_ = "//preview.imm.aliyun.com/doc/18/V3.9.0/";
      window._view_env_ = {
        enableCopy: processObj.copy,
        watermarkType: processObj.wmType,
        watermark: processObj.wmValue,
        watermarkSetting: {
          fillstyle: processObj.wmColor,
          rotate: processObj.wmRotate,
          font: processObj.wmFont,
          height: processObj.wmHeight,
          width: processObj.wmWidth
        }
      };
      window._data_ = {};
      window._version_ = "3.9.0";
      window._preview_params = {
        url: '//imm-prod-cn-beijing-preview.oss-cn-beijing.aliyuncs.com/7F2420C84E7C14CB9DF2649EB1E3787E',
        accessKeyId: 'STS.NZkdnMDhSMczAjkLLYtMgYFiL',
        accessKeySecret: 'BKmvtt61g7PV1ieJvGyUcLeCyZiBy8PSHYycznLJxHeZ',
        region: 'oss-cn-beijing',
        bucket: 'imm-prod-cn-beijing-preview',
        stsToken: ''
      };
    }();
  </script>
  <style>
    .wps-widget-loading {
      display: none;
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: 100%;
      z-index: 1000;
      zoom: 1
    }

    .wps-widget-loading img {
      width: 60px;
      height: 60px;
      position: absolute;
      left: 50%;
      top: 50%;
      margin-top: -30px;
      margin-left: -30px
    }
  </style>
</head>

<body>
  <div class="wps-widget-loading" id="wpsLoading" style="display:block">
    <img src="data:image/gif;base64,">
  </div>
  <script>
    !function () {
      var n = [],
        t = location.search.match(/version\=(\d+\.\d+\.\d+)/);

      function i(t, i) {
        var s = _static_url_ + t;
        n.push(i ? '<link href="' + s + "-bundle.css?v=" + _version_ + '" rel="stylesheet"></link>' 
          : '<script src="' + s + "-bundle.js?v=" + _version_ + '" ><\/script>')
      }
      t && t[1] && (window._version_ = t[1], window._static_host_ = _static_host_.replace(/\/V3.1.0\/$/, "/V" +
        _version_ + "/"));
      n = n.concat([
        '<script src="' + _static_host_.replace('/V' + _version_ + '/', '') + '/static/oss-sdk.js"><\/script>',
        '<script src="' + _static_host_.replace('/V' + _version_ + '/', '') + '/oss-process/config.js"><\/script>'
      ]);
      window._static_url_ = _static_host_;
      i("vendor");
      var s = window.navigator.userAgent.match(/MSIE\s(\d+)/);
      s && s[1] <= 8 && i("ie8");
      i("index");
      document.write(n.join(""));
    }()
  </script>
</body>

</html>
